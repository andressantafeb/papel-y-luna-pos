# Copia este archivo a ".env" y ajusta los valores. NO subas ".env" al repositorio.

# Puerto del API
PORT=3000

# Conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/papel_y_luna
# Poner en true para bases en la nube que exigen SSL (Render, Neon, Supabase...)
DB_SSL=false

# Clave para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=12h

# Orígenes permitidos por CORS, separados por coma. "*" permite cualquiera (solo desarrollo).
CORS_ORIGIN=*

# Zona horaria para filtros por fecha (historial, reportes)
APP_TIMEZONE=America/Bogota

# Contraseñas de los usuarios iniciales (opcional; estos son los valores por defecto)
SEED_ADMIN_PASSWORD=Admin123*
SEED_CAJERO_PASSWORD=Cajero123*
